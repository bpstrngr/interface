 ,"module.js":["path/index.js",{dialect:"commonjs",alias:{specifier:""},edit:{regexp:"source"},replace:{string:"bundle"}}]
 ,"module.js":{"protocol://domain/author/module":["index.js","entry2.js"]}
 ,"module.js":{"protocol://domain/author/module":{"branch":["path/index.js","../../module.patch"]}}
 ,"module.js":{"protocol://domain/author/module/tarball/branch":["path/index.js"]}
 ,"module.js":{"protocol://domain/author/module/sparse/checkout/path sparse/checkout/path":{"branch or tag":["path/index.js"]}}
 };
`){background:transparent;max-width:90%;margin:auto;overflow:scroll;border-radius:.5em; border:2px dashed #616161}

 For example, Interface itself imports external modules for a general parser (acorn) and serializer/bundler (astring and rollup) to standardize dialects (though bound for replacement by the Meta#b module's own parse#b and denote#b functions; see (issue 4)@https://github.com/bpstrngr/interface/issues/4 and 5@https://github.com/bpstrngr/interface/issues/5): 

